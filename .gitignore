# Real secrets - GitHub client secret, Streamlabs client secret/access
# token, Twitch client secret, ocr_agent_secret, etc. config.example.json
# is the safe, committable template and is NOT covered by this pattern -
# only the exact filename "config.json" is ignored.
config.json

# Python virtual environment
venv/

# Python bytecode cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Test cache
.pytest_cache/

# Local points ledger - real viewer usernames and their balances. Written
# by points_local.py when points_backend is "local"; not a secret, but not
# ours to publish either.
points_local.json

# Runtime logs
logs/
*.log

# User-uploaded clip video files - large binary content, not source code
clips/

# macOS
.DS_Store

# Editor
.vscode/
.idea/